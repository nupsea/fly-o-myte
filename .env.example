# ─── Travo Environment Configuration ─────────────────────────────────────────
# Copy this file to .env and fill in your values.
# The .env file must never be committed to version control.
#
# Installation:  uv tool install travo
# First run:     travo setup   (interactive wizard — sets ~/.travo/config.yaml)

# ─── Flight Data API ─────────────────────────────────────────────────────────
# Kiwi.com Tequila API — primary flight data source (Phase 1)
# Sign up free at: https://tequila.kiwi.com/
TEQUILA_API_KEY=your_tequila_api_key_here

# Amadeus — international routes supplement (Phase 2/3, optional)
# Sign up free at: https://developers.amadeus.com/
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOSTNAME=test   # "test" for sandbox, "production" for live

# ─── LLM Intelligence ────────────────────────────────────────────────────────
# Claude API — for contextual flight insights (Phase 2)
# Obtain at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Ollama — local LLM alternative (optional, no key needed if running locally)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ─── Observability ───────────────────────────────────────────────────────────
# Pydantic Logfire — LLM call tracing (Phase 2, optional)
# Sign up free at: https://logfire.pydantic.dev/
LOGFIRE_TOKEN=

# ─── Notifications ───────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.alerts@gmail.com
SMTP_PASS=your_app_password_here
DEFAULT_ALERT_EMAIL=your@email.com

# ─── Storage ─────────────────────────────────────────────────────────────────
# Defaults shown — override only if needed
# TRAVO_DB_PATH=~/.travo/travo.db
# TRAVO_ANALYTICS_DIR=~/.travo/analytics
# TRAVO_CONFIG_PATH=~/.travo/config.yaml
# TRAVO_LOG_PATH=~/.travo/travo.log
