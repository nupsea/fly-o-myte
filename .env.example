# ─── fly-o-myte Environment Configuration ─────────────────────────────────────────
# Copy this file to .env and fill in your values.
# The .env file must never be committed to version control.
#
# Installation:  uv tool install fly-o-myte
# First run:     fom setup   (interactive wizard — sets ~/.fly-o-myte/config.yaml)

# ─── Flight Data API ─────────────────────────────────────────────────────────
# SerpAPI — Google Flights scraper (primary source, 100 free searches/month)
# Sign up free at: https://serpapi.com  — API key at: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=your_serpapi_key_here

# Kiwi.com Tequila API — legacy fallback (sign-up broken as of 2026, kept for reference)
TEQUILA_API_KEY=

# Amadeus — international routes supplement (Phase 2/3, optional)
# Sign up free at: https://developers.amadeus.com/
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOSTNAME=test   # "test" for sandbox, "production" for live

# ─── LLM Intelligence ────────────────────────────────────────────────────────
# Claude API — for contextual flight insights (Phase 2)
# Obtain at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Ollama — local LLM alternative (optional, no key needed if running locally)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ─── Observability ───────────────────────────────────────────────────────────
# Pydantic Logfire — LLM call tracing (Phase 2, optional)
# Sign up free at: https://logfire.pydantic.dev/
LOGFIRE_TOKEN=

# ─── Notifications ───────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.alerts@gmail.com
SMTP_PASS=your_app_password_here
DEFAULT_ALERT_EMAIL=your@email.com

# ─── Storage ─────────────────────────────────────────────────────────────────
# Defaults shown — override only if needed
# FLY_O_MYTE_DB_PATH=~/.fly-o-myte/fly-o-myte.db
# FLY_O_MYTE_ANALYTICS_DIR=~/.fly-o-myte/analytics
# TRAVO_CONFIG_PATH=~/.fly-o-myte/config.yaml
# FLY_O_MYTE_LOG_PATH=~/.fly-o-myte/fly-o-myte.log
